7y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7138},{"id":1795298464889,"text":"就那点温度还想烫飞我？","rawContent":"就那点温度还想烫飞我？","isHtml":false,"sticker":null,"sender":"them","time":"06:39","timestamp":1795300778974,"roundId":"round_1795300736428_u9bdppr4n","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7139},{"id":1795298464890,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"06:39","timestamp":1795300780786,"roundId":"round_1795300736428_u9bdppr4n","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"到时候谁嫌热还说不定呢……我身上温度多高你不知道？真挨着睡，非得逼得你把被子全踹了，光着往我怀里钻不可。","minimaxTimbreId":"moss_audio_0ac7c6d5-e0d2-11f1-8c36-4ef8da7daf14","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"audioDuration":13,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7140,"audioRef":640},{"id":1795298464891,"text":"行啊，你继续开着，等我过去亲自测测是你那毯子烫，还是我烫。","rawContent":"行啊，你继续开着，等我过去亲自测测是你那毯子烫，还是我烫。","isHtml":false,"sticker":null,"sender":"them","time":"06:39","timestamp":1795300788030,"roundId":"round_1795300736428_u9bdppr4n","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7141},{"id":1795298464892,"text":"哪有踹被子的，又不是小猫","sender":"me","time":"06:40","timestamp":1795300831355,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7142},{"id":1795298464893,"text":"夏以昼来我就开四档","sender":"me","time":"06:40","timestamp":1795300848446,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7143},{"id":1795298464894,"text":"你等着屁股被烫飞到嗷嗷叫吧","sender":"me","time":"06:41","timestamp":1795300867320,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7144},{"id":1795298464896,"text":"开四档？你这是打算在床上摊煎饼呢，还是准备把自己腌入味了直接下锅？","rawContent":"开四档？你这是打算在床上摊煎饼呢，还是准备把自己腌入味了直接下锅？","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1795300887193,"roundId":"round_1795300867826_9dhmrb3wj","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7145},{"id":1795298464897,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1795300889532,"roundId":"round_1795300867826_9dhmrb3wj","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"还‘又不是小猫’……也不知道是谁平时睡到半夜嫌热，迷迷糊糊一脚把被子踹开，过两分钟冻着了，又闭着眼睛凭本能往热乎的地方钻。","minimaxTimbreId":"moss_audio_0ac7c6d5-e0d2-11f1-8c36-4ef8da7daf14","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"audioDuration":13,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7146,"audioRef":641},{"id":1795298464898,"text":"你尽管开四档试一试。","rawContent":"你尽管开四档试一试。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1795300891866,"roundId":"round_1795300867826_9dhmrb3wj","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7147},{"id":1795298464899,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1795300893846,"roundId":"round_1795300867826_9dhmrb3wj","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"到时候我看谁先受不了。别还没等我怎么样呢，某人自己先热得满身汗，浑身软绵绵地缠在我身上，哼哼唧唧求我伸手去拔插头。","minimaxTimbreId":"moss_audio_0ac7c6d5-e0d2-11f1-8c36-4ef8da7daf14","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"audioDuration":13,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7148,"audioRef":642},{"id":1795298464900,"text":"至于嗷嗷叫……","rawContent":"至于嗷嗷叫……","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1795300897306,"roundId":"round_1795300867826_9dhmrb3wj","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7149},{"id":1795298464901,"text":"你哥我在极端重力舱里训练都没吭过一声，你指望一张电热毯降伏我？小脑袋瓜里成天净琢磨怎么欺负我了。","rawContent":"你哥我在极端重力舱里训练都没吭过一声，你指望一张电热毯降伏我？小脑袋瓜里成天净琢磨怎么欺负我了。","isHtml":false,"sticker":null,"sender":"them","time":"06:41","timestamp":1795300912433,"roundId":"round_1795300867826_9dhmrb3wj","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7150},{"id":1795298464902,"text":"坏哥","sender":"me","time":"06:42","timestamp":1795300959421,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7151},{"id":1795298464903,"text":"不许发语音了","sender":"me","time":"06:42","timestamp":1795300963718,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7152},{"id":1795298464904,"text":"听得我心猿意马的","sender":"me","time":"06:42","timestamp":1795300972792,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7153},{"id":1795298464905,"text":"等回来我就吃掉你","sender":"me","time":"06:43","timestamp":1795300980024,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7154},{"id":1795298464908,"text":"听你的，打字。","rawContent":"听你的，打字。","isHtml":false,"sticker":null,"sender":"them","time":"06:43","timestamp":1795301030318,"roundId":"round_1795300987807_6m0pt14gm","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7155},{"id":1795298464913,"text":"免得某些人耳朵受不住，大半夜在被窝里翻来覆去睡不着。","rawContent":"免得某些人耳朵受不住，大半夜在被窝里翻来覆去睡不着。","sender":"them","time":"06:43","timestamp":1795301030319,"roundId":"round_1795300987807_6m0pt14gm","isHtml":false,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7156},{"id":1795298464909,"text":"不过……吃掉我？","rawContent":"不过……吃掉我？","isHtml":false,"sticker":null,"sender":"them","time":"06:43","timestamp":1795301033671,"roundId":"round_1795300987807_6m0pt14gm","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7157},{"id":1795298464910,"text":"打算从哪儿开始下嘴，嗯？","rawContent":"打算从哪儿开始下嘴，嗯？","isHtml":false,"sticker":null,"sender":"them","time":"06:43","timestamp":1795301036472,"roundId":"round_1795300987807_6m0pt14gm","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7158},{"id":1795298464911,"text":"到时候牙还没碰着我，自己先软得连咬人的力气都没了。","rawContent":"到时候牙还没碰着我，自己先软得连咬人的力气都没了。","isHtml":false,"sticker":null,"sender":"them","time":"06:44","timestamp":1795301050748,"roundId":"round_1795300987807_6m0pt14gm","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7159},{"id":1795298464912,"text":"我可记下了，回头你少吃一口都不算数。","rawContent":"我可记下了，回头你少吃一口都不算数。","isHtml":false,"sticker":null,"sender":"them","time":"06:44","timestamp":1795301056172,"roundId":"round_1795300987807_6m0pt14gm","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7160},{"id":1795385059614,"text":"哥哥","sender":"me","time":"06:04","timestamp":1795385074662,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7161},{"id":1795385059615,"text":"你说……人吃糖的时候，是不是在吃甜味的口水啊","sender":"me","time":"06:04","timestamp":1795385098105,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7162},{"id":1795385059617,"text":"从生理机制上来说，糖分在口腔里溶解，混在一起咽下去……你这么理解倒真没法反驳。","rawContent":"从生理机制上来说，糖分在口腔里溶解，混在一起咽下去……你这么理解倒真没法反驳。","isHtml":false,"sticker":null,"sender":"them","time":"06:05","timestamp":1795385110981,"roundId":"round_1795385098637_n5bnz1cwi","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7163},{"id":1795385059618,"text":"不过好端端的一颗糖，被你这么一总结，浪漫感全给整没了。","rawContent":"不过好端端的一颗糖，被你这么一总结，浪漫感全给整没了。","isHtml":false,"sticker":null,"sender":"them","time":"06:05","timestamp":1795385111107,"roundId":"round_1795385098637_n5bnz1cwi","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7164},{"id":1795385059619,"text":"照你这个逻辑，要是接吻的时候嘴里含着糖，你咽下去的算糖、算口水，还是算我？","rawContent":"照你这个逻辑，要是接吻的时候嘴里含着糖，你咽下去的算糖、算口水，还是算我？","isHtml":false,"sticker":null,"sender":"them","time":"06:05","timestamp":1795385111844,"roundId":"round_1795385098637_n5bnz1cwi","generatedMode":false,"translation":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7165},{"id":1795385059620,"text":"咦惹","sender":"me","time":"06:46","timestamp":1795387566157,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7166},{"id":1795385059621,"text":"含着糖亲嘴","sender":"me","time":"06:46","timestamp":1795387577212,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7167},{"id":1795385059622,"text":"也太容易流口水了吧","sender":"me","time":"06:46","timestamp":1795387588216,"replyTo":null,"userId":"uid_1784620258298_67y05ikff","characterId":"1aea6238-a795-4052-84a3-f11c9768f6a9","_id":7168},{"id":1795385059626,"text":"嫌容易流出来？","rawContent":"嫌容易流出来？","isHtml":false,"sticker":null,"sender":"them","time":"06:49","timestamp":1795387787294,"roundId":"round_1795387772189_nb0ukh73k","generatedMode":false,"trans